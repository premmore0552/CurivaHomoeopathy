# Razorpay checkout (public key is build-time VITE_*, secret is server-only)
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server-only Firebase service account JSON (never prefix with VITE_ and never commit actual credentials)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_DATABASE_ID=
FIREBASE_WEB_API_KEY=

# Gemini API Integration
GEMINI_API_KEY=

# Google Custom Search API
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
