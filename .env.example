# Razorpay checkout (public key is build-time VITE_*, secret is server-only)
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server-only Firebase service account JSON (never prefix with VITE_* and never commit actual credentials)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_DATABASE_ID=
FIREBASE_WEB_API_KEY=

# Private Cloud Storage: bucket must have public access prevention enabled.
# Upload the resource PDF as resources/homoeopathy-modalities-cheat-sheet.pdf.
CURIVA_PRIVATE_DOWNLOAD_BUCKET=

# Resend transactional email; sender domain/address must be verified in Resend.
RESEND_API_KEY=
RESOURCE_EMAIL_FROM=
CURIVA_APPOINTMENT_NOTIFICATION_EMAIL=

# Clinic Google Calendar; confirmation is disabled until configured and tested.
CURIVA_CLINIC_CALENDAR_ID=
CURIVA_CLINIC_TIMEZONE=
CURIVA_APPOINTMENT_ADMIN_UIDS=
CURIVA_APPOINTMENT_DURATION_MINUTES=30

# Gemini API Integration
GEMINI_API_KEY=

# Google Custom Search API
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
