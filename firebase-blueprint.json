{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profiles, content interaction, and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "bookmarks": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "Array of blog post IDs"
        },
        "readingHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "postId": { "type": "string" },
              "timestamp": { "type": "string", "format": "date-time" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Question": {
      "title": "Ask a Homeopath Question",
      "description": "Questions submitted by users and answered by professionals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "subject": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "answered", "featured"] },
        "answer": { "type": "string" },
        "answeredBy": { "type": "string" },
        "answeredAt": { "type": "string", "format": "date-time" },
        "isAnonymous": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subject", "content", "status", "createdAt"]
    },
    "Admin": {
      "title": "Administrator",
      "description": "System administrators and professionals",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "homeopath"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and subscription data"
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "User questions and expert answers"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized administrators and professionals"
    }
  }
}
