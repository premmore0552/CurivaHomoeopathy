rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Checking if the user is authenticated and is the owner of the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checking if user is admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'premmore0552@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) && 
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200;
    }

    function isValidQuestion(data) {
      return data.keys().hasAll(['userId', 'subject', 'content', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.subject is string && data.subject.size() >= 5 && data.subject.size() <= 200 &&
             data.content is string && data.content.size() >= 10 && data.content.size() <= 2000 &&
             data.status in ['pending', 'answered', 'featured'];
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'resourceId', 'resourceTitle', 'paymentId', 'status', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 200 &&
             data.resourceId is string && data.resourceId.size() <= 100 &&
             data.resourceTitle is string && data.resourceTitle.size() <= 500 &&
             data.paymentId is string && data.paymentId.size() <= 200 &&
             data.status in ['paid', 'pending', 'failed'];
    }

    // --- Collection: Users ---
    
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) && 
                      isValidUser(incoming()) &&
                      incoming().createdAt == request.time;
      
      allow update: if isOwner(userId) && 
                       incoming().uid == existing().uid &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'photoURL', 'profession', 'bio', 'qualifications', 
                         'clinicAddress', 'interests', 'bookmarks', 'readingHistory', 
                         'activities', 'studyStats', 'updatedAt'
                       ]) &&
                       incoming().updatedAt == request.time;

      allow update: if isAdmin() && 
                       incoming().diff(existing()).affectedKeys().hasAny(['updatedAt']) &&
                       incoming().updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // --- Collection: Questions ---
    match /questions/{questionId} {
      allow read: if resource.data.status == 'featured' || resource.data.status == 'answered';
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() && 
                      isValidQuestion(incoming()) &&
                      incoming().status == 'pending' &&
                      incoming().createdAt == request.time;
      
      allow update: if isAdmin() && 
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'answer', 'answeredBy', 'answeredAt', 'updatedAt']) &&
                       incoming().updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // --- Collection: Orders ---
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if (
                      (isSignedIn() && incoming().userId == request.auth.uid) ||
                      (!isSignedIn() && incoming().userId == 'guest')
                    ) &&
                    isValidOrder(incoming()) &&
                    incoming().createdAt == request.time;
      
      allow update: if false;
      allow delete: if isAdmin();
    }

    // --- Collection: Test for Connection ---
    match /test/connection {
      allow get: if true;
    }

    // --- Collection: Admins ---
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
