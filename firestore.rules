rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Checking if the user is authenticated and is the owner of the document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Checking if user is admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'premmore0552@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) && 
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200;
    }

    function isValidQuestion(data) {
      return data.keys().hasAll(['userId', 'subject', 'content', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.subject is string && data.subject.size() >= 5 && data.subject.size() <= 200 &&
             data.content is string && data.content.size() >= 10 && data.content.size() <= 2000 &&
             data.status in ['pending', 'answered', 'featured'];
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'resourceId', 'resourceTitle', 'paymentId', 'status', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 200 &&
             data.resourceId is string && data.resourceId.size() <= 100 &&
             data.resourceTitle is string && data.resourceTitle.size() <= 500 &&
             data.paymentId is string && data.paymentId.size() <= 200 &&
             data.status in ['pending', 'failed']; // Client writes can never assert payment as paid.
    }

    function isValidKit(data) {
      return data.keys().hasAll(['id', 'userId', 'userEmail', 'status', 'createdAt']) &&
             data.id is string && data.id.size() <= 100 &&
             data.userId == request.auth.uid &&
             data.userEmail is string && data.userEmail.size() <= 200 &&
             data.status in ['ordered', 'shipped', 'delivered', 'active', 'sent_back', 'processing', 'completed'];
    }

    function isValidScreening(data) {
      return data.keys().hasAll(['id', 'userId', 'riskLevel', 'createdAt']) &&
             data.id is string && data.id.size() <= 100 &&
             data.userId == request.auth.uid &&
             data.riskLevel in ['low', 'moderate', 'high'];
    }

    // --- Collection: Users ---
    
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isOwner(userId) || (isSignedIn() && request.auth.token.email == 'premmore0552@gmail.com');
      
      allow create: if isOwner(userId) && 
                      isValidUser(incoming()) &&
                      incoming().createdAt == request.time;
      
      allow update: if isOwner(userId) && 
                       incoming().uid == existing().uid &&
                       incoming().email == existing().email &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'photoURL', 'profession', 'bio', 'qualifications', 
                         'clinicAddress', 'interests', 'bookmarks', 'readingHistory', 
                         'activities', 'studyStats', 'streakCount', 'lastActiveDate', 
                         'phoneNumber', 'updatedAt'
                       ]) &&
                       incoming().updatedAt == request.time;

      allow update: if isAdmin() && 
                       incoming().diff(existing()).affectedKeys().hasAny(['updatedAt']) &&
                       incoming().updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // --- Collection: Questions ---
    match /questions/{questionId} {
      allow get: if resource.data.status == 'featured' || resource.data.status == 'answered';
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow list: if resource.data.status == 'featured' || resource.data.status == 'answered';
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'premmore0552@gmail.com');
      
      allow create: if isSignedIn() && 
                      isValidQuestion(incoming()) &&
                      incoming().status == 'pending' &&
                      incoming().createdAt == request.time;
      
      allow update: if isAdmin() && 
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'answer', 'answeredBy', 'answeredAt', 'updatedAt']) &&
                       incoming().updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // --- Collection: Orders ---
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'premmore0552@gmail.com');
      
      allow create: if (
                      (isSignedIn() && incoming().userId == request.auth.uid) ||
                      (!isSignedIn() && incoming().userId == 'guest')
                    ) &&
                    isValidOrder(incoming()) &&
                    incoming().createdAt == request.time;
      
      allow update: if false;
      allow delete: if isAdmin();
    }

    // --- Collection: Kits ---
    match /kits/{kitId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'premmore0552@gmail.com');
      allow create: if isSignedIn() && isValidKit(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && incoming().userId == resource.data.userId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // --- Collection: Screenings ---
    match /screenings/{screeningId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'premmore0552@gmail.com');
      allow create: if isSignedIn() && isValidScreening(incoming()) && incoming().createdAt == request.time;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && incoming().userId == resource.data.userId;
      allow delete: if isAdmin();
    }

    // --- Collection: Appointment Requests ---
    // Request workflow only; do not store symptoms or medical records here.
    function isValidAppointmentRequest(data) {
      return data.keys().hasAll([
               'userId', 'userEmail', 'displayName', 'phoneNumber',
               'serviceType', 'preferredDate', 'preferredTime',
               'timezone', 'status', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'userEmail', 'displayName', 'phoneNumber',
               'serviceType', 'preferredDate', 'preferredTime',
               'timezone', 'status', 'createdAt', 'updatedAt'
             ]) &&
             data.userId == request.auth.uid &&
             data.userEmail == request.auth.token.get('email', null) &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.phoneNumber is string && data.phoneNumber.size() <= 30 &&
             data.serviceType in ['initial-consultation', 'follow-up', 'general-consultation'] &&
             data.preferredDate is string &&
             data.preferredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
             data.preferredTime in ['morning', 'afternoon', 'evening'] &&
             data.timezone is string && data.timezone.size() <= 80 &&
             data.status == 'requested' &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    match /appointmentRequests/{requestId} {
      allow create: if isSignedIn() && isValidAppointmentRequest(incoming());

      // Owners can only access their own requests. Admin access is separately authorized.
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);

      // Only admins can record clinic review/confirmation. Confirmation must be explicit.
      allow update: if isAdmin() &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminResponse', 'updatedAt']) &&
                    incoming().status in ['requested', 'confirmed', 'declined', 'cancelled'] &&
                    incoming().updatedAt == request.time &&
                    (!incoming().keys().hasAny(['adminResponse']) ||
                      (incoming().adminResponse is string && incoming().adminResponse.size() <= 500));

      // Requesters may cancel a request that is still awaiting review, but cannot confirm it.
      allow update: if isSignedIn() &&
                    existing().userId == request.auth.uid &&
                    existing().status == 'requested' &&
                    incoming().userId == existing().userId &&
                    incoming().status == 'cancelled' &&
                    incoming().updatedAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if false;
    }

    // --- Collection: Test for Connection ---
    match /test/connection {
      allow get: if true;
    }

    // --- Collection: Admins ---
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
