{
  "name": "curiva-homoeopathy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "build": "npm run sitemap && vite build && node scripts/create-live-update-bundle.mjs && mkdir -p .server-build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=.server-build/server.cjs",
    "start": "node .server-build/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist .server-build",
    "lint": "tsc --noEmit",
    "cap:add": "cap add android",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "import:boericke": "node scripts/import-boericke-ocr.mjs",
    "prebuild": "node scripts/import-boericke-ocr.mjs && tsx scripts/generate-disease-hub-assets.ts",
    "predev": "npm run import:boericke && tsx scripts/generate-disease-hub-assets.ts",
    "test:boericke": "node --test tests/boericke-import.test.mjs",
    "test:native-progress": "tsx --test tests/native-progress-sync.test.ts",
    "test:study-toolkit-sync": "tsx --test tests/study-toolkit-sync.test.ts",
    "test:chauhan-question-bank": "tsx --test tests/chauhan-question-bank.test.ts",
    "export:native-content": "tsx scripts/export-native-content.ts",
    "test:privacy-security": "node --test tests/privacy-security-hardening.test.mjs && tsx --test tests/ai-privacy-guard.test.ts",
    "verify:deploy-preview": "node scripts/verify-deploy-preview.mjs",
    "test:disease-assets": "tsx --test tests/disease-hub-assets.test.ts",
    "test:auth": "tsx --test tests/auth-error-message.test.ts",
    "test:organon-curriculum": "tsx --test tests/organon-curriculum.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.4.1",
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^6.2.1",
    "d3": "^7.9.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "firebase": "^12.12.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "razorpay": "^2.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "tsx": "^4.23.15",
    "@capawesome/capacitor-live-update": "^8.7.1",
    "serverless-http": "^4.0.0",
    "express-rate-limit": "^8.7.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.4",
    "terser": "^5.46.1",
    "typescript": "~7.0.2",
    "vite": "^6.4.5"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "qs": "^6.17.1",
    "@grpc/grpc-js": "^1.13.6"
  }
}
