{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "build": "npm run sitemap && vite build && node scripts/create-live-update-bundle.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "cap:add": "cap add android",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "import:boericke": "node scripts/import-boericke-ocr.mjs",
    "prebuild": "node scripts/import-boericke-ocr.mjs",
    "predev": "npm run import:boericke",
    "test:boericke": "node --test tests/boericke-import.test.mjs",
    "test:native-progress": "tsx --test tests/native-progress-sync.test.ts",
    "test:study-toolkit-sync": "tsx --test tests/study-toolkit-sync.test.ts",
    "test:chauhan-question-bank": "tsx --test tests/chauhan-question-bank.test.ts",
    "export:native-content": "tsx scripts/export-native-content.ts",
    "test:privacy-security": "node --test tests/privacy-security-hardening.test.mjs && tsx --test tests/ai-privacy-guard.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.4.1",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "razorpay": "^2.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^2.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "tsx": "^4.21.0",
    "vite": "^6.2.0",
    "@capawesome/capacitor-live-update": "^8.7.1",
    "serverless-http": "^4.0.0",
    "express-rate-limit": "^8.7.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "terser": "^5.46.1",
    "typescript": "~7.0.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
